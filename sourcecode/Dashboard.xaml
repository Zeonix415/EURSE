<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#111820" TextElement.Foreground="#EDF5F7" TextElement.FontFamily="Segoe UI" ClipToBounds="True">
  <Grid.Resources>
    <SolidColorBrush x:Key="Muted" Color="#AAC0C7"/>
    <SolidColorBrush x:Key="Accent" Color="#A4E7D9"/>
    <QuadraticEase x:Key="EaseOut" EasingMode="EaseOut"/>
    <LinearGradientBrush x:Key="Glass" StartPoint="0,0" EndPoint="0.78,1">
      <GradientStop Color="#9E293944" Offset="0"/>
      <GradientStop Color="#C018242E" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Rim" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#78C3D4DE" Offset="0"/>
      <GradientStop Color="#2A96ABB9" Offset="0.65"/>
      <GradientStop Color="#4BAFC2CB" Offset="1"/>
    </LinearGradientBrush>
    <Style x:Key="Frost" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Glass}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Rim}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="Padding" Value="16"/>
    </Style>
    <Style x:Key="Kicker" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Consolas"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#352C4652"/>
      <Setter Property="BorderBrush" Value="#5E9AB5C2"/>
      <Setter Property="Foreground" Value="#F0FAFA"/>
      <Setter Property="Padding" Value="11,6"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Background="{TemplateBinding Background}" RenderTransformOrigin="0.5,0.5"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8">
              <Border.RenderTransform><ScaleTransform x:Name="PressScale" ScaleX="1" ScaleY="1"/></Border.RenderTransform>
              <Grid>
                <Border x:Name="HoverGlow" CornerRadius="7" Background="#D5FFFF" Opacity="0" IsHitTestVisible="False"/>
                <Border x:Name="PressShade" CornerRadius="7" Background="#122630" Opacity="0" IsHitTestVisible="False"/>
                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <EventTrigger RoutedEvent="MouseEnter">
                <BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="HoverGlow" Storyboard.TargetProperty="Opacity" To="0.17" Duration="0:0:0.16" EasingFunction="{StaticResource EaseOut}"/>
                </Storyboard></BeginStoryboard>
              </EventTrigger>
              <EventTrigger RoutedEvent="MouseLeave">
                <BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="HoverGlow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22" EasingFunction="{StaticResource EaseOut}"/>
                </Storyboard></BeginStoryboard>
              </EventTrigger>
              <Trigger Property="IsPressed" Value="True">
                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleX" To="0.969" Duration="0:0:0.095" EasingFunction="{StaticResource EaseOut}"/>
                  <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleY" To="0.94" Duration="0:0:0.095" EasingFunction="{StaticResource EaseOut}"/>
                  <DoubleAnimation Storyboard.TargetName="PressShade" Storyboard.TargetProperty="Opacity" To="0.2" Duration="0:0:0.095"/>
                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.19" EasingFunction="{StaticResource EaseOut}"/>
                  <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.19" EasingFunction="{StaticResource EaseOut}"/>
                  <DoubleAnimation Storyboard.TargetName="PressShade" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                </Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#E8FCFF"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.42"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background">
        <Setter.Value>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#BDEBDD" Offset="0"/><GradientStop Color="#8DD0CA" Offset="1"/>
          </LinearGradientBrush>
        </Setter.Value>
      </Setter>
      <Setter Property="Foreground" Value="#0B2B31"/>
      <Setter Property="BorderBrush" Value="#BCEBDF"/>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="10"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="#142D3D46">
              <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False">
                    <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template>
                  </RepeatButton>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb>
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Grip" Background="#758CA5AE" CornerRadius="3" Margin="2,0,1,0"/>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Background" Value="#B6BBD3D9"/></Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False">
                    <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template>
                  </RepeatButton>
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="TraceItem" TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Line" CornerRadius="5" Background="{TemplateBinding Background}" Padding="6,5">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Line" Property="Background" Value="#223FA1A6"/></Trigger>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="Line" Property="Background" Value="#403FA1A6"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Grid.Resources>

  <Grid x:Name="PhotoLayer" IsHitTestVisible="False"/>
  <Rectangle IsHitTestVisible="False">
    <Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#320A1420" Offset="0"/>
      <GradientStop Color="#08091720" Offset="0.45"/>
      <GradientStop Color="#6B08101B" Offset="1"/>
    </LinearGradientBrush></Rectangle.Fill>
  </Rectangle>
  <Grid x:Name="RainLayerHost" IsHitTestVisible="False"/>


  <Grid Margin="29,19,29,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="108"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="56"/>
    </Grid.RowDefinitions>
    <Grid Margin="2,0,2,10">
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="ROB RUN   /   CONNECTION PATCH" Style="{StaticResource Kicker}" Foreground="{StaticResource Accent}"/>
        <TextBlock Text="EURSE" FontSize="52" FontWeight="Light" LineHeight="60" LineStackingStrategy="BlockLineHeight"/>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="288"/>
        <ColumnDefinition Width="14"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border x:Name="SetupGlass" Style="{StaticResource Frost}">
        <StackPanel>
          <TextBlock Text="Connection patch" FontSize="22" FontWeight="SemiBold"/>
          <TextBlock Text="Launch ROB RUN before starting the patch." TextWrapping="Wrap"
                     Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,0,21"/>
          <TextBlock Text="CONTROLS" Style="{StaticResource Kicker}" Margin="0,0,0,7"/>
          <Button x:Name="StartPatch" Content="Start patch" Style="{StaticResource Primary}" Height="38" Margin="0,0,0,8"/>
          <Button x:Name="StopPatch" Content="Safe stop" Height="36" Margin="0,0,0,17"/>
          <Border Background="#5623323D" BorderBrush="#46658290" BorderThickness="1" CornerRadius="8" Padding="11">
            <StackPanel>
              <TextBlock Text="WINDOWS NETWORK PATCH" Style="{StaticResource Kicker}" Foreground="{StaticResource Accent}"/>
              <TextBlock Text="Approve administrator access to let EURSE manage temporary network routes." Foreground="{StaticResource Muted}"
                         FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"/>
            </StackPanel>
          </Border>
          <TextBlock Text="Experimental and unofficial. Compatibility with Easy Anti-Cheat is unverified." TextWrapping="Wrap"
                     Foreground="{StaticResource Muted}" FontSize="11" Margin="0,17,0,0"/>
        </StackPanel>
      </Border>

      <Grid Grid.Column="2">
        <Grid.RowDefinitions><RowDefinition Height="108"/><RowDefinition Height="14"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Border x:Name="ClientGlass" Style="{StaticResource Frost}" Padding="13">
            <StackPanel>
              <TextBlock Text="GAME PROCESS" Style="{StaticResource Kicker}"/>
              <TextBlock x:Name="GameState" Text="CHECKING" FontSize="17" FontWeight="SemiBold" Margin="0,7,0,4"/>
              <TextBlock x:Name="GameDetail" Text="ROB RUN" FontSize="11" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
          </Border>
          <Border x:Name="GatewayGlass" Grid.Column="2" Style="{StaticResource Frost}" Padding="13">
            <StackPanel>
              <TextBlock Text="PATCH" Style="{StaticResource Kicker}"/>
              <TextBlock x:Name="PatchState" Text="STANDBY" FontSize="17" FontWeight="SemiBold" Margin="0,7,0,4"/>
              <TextBlock x:Name="PatchDetail" Text="Bundled release v0.3.2" FontSize="11" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
          </Border>
          <Border x:Name="PartyGlass" Grid.Column="4" Style="{StaticResource Frost}" Padding="13">
            <StackPanel>
              <TextBlock Text="BATTLE CONNECTION" Style="{StaticResource Kicker}"/>
              <TextBlock x:Name="ConnectionState" Text="NO EVENT" FontSize="17" FontWeight="SemiBold" Margin="0,7,0,4"/>
              <TextBlock x:Name="ConnectionDetail" Text="Waiting for patch events" FontSize="11" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
          </Border>
        </Grid>

        <Border x:Name="LogGlass" Grid.Row="2" Style="{StaticResource Frost}" Padding="14,12">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="39"/><RowDefinition Height="25"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid>
              <TextBlock Text="Diagnostics" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" Margin="2,0,0,0"/>
              <Button x:Name="Export" Content="Export log" HorizontalAlignment="Right" VerticalAlignment="Center" Height="30"/>
            </Grid>
            <Border Grid.Row="1" BorderThickness="0,0,0,1" BorderBrush="#386C8996" Padding="6,0">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="87"/><ColumnDefinition Width="53"/><ColumnDefinition Width="88"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <TextBlock Text="LOCAL TIME" Style="{StaticResource Kicker}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="LEVEL" Style="{StaticResource Kicker}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="SOURCE" Style="{StaticResource Kicker}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="3" Text="EVENT" Style="{StaticResource Kicker}" VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <ListBox x:Name="Events" Grid.Row="2" Background="Transparent" BorderThickness="0" Padding="0"
                     FontFamily="Consolas" FontSize="12" ItemContainerStyle="{StaticResource TraceItem}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="87"/><ColumnDefinition Width="53"/><ColumnDefinition Width="88"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Time}" Foreground="#B1C1CC"/>
                    <TextBlock Grid.Column="1" Text="{Binding Level}" Foreground="{Binding Tone}"/>
                    <TextBlock Grid.Column="2" Text="{Binding Component}" Foreground="#C7DBE1" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="3" Text="{Binding Message}" Foreground="#EDF5F7" TextWrapping="Wrap"/>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <Border x:Name="StatusGlass" Grid.Row="2" Style="{StaticResource Frost}" Padding="13,7" CornerRadius="11" Margin="0,13,0,0">
      <Grid>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Ellipse Width="6" Height="6" Fill="{StaticResource Accent}" Margin="0,0,8,0"/>
          <TextBlock x:Name="Status" Text="WAITING FOR ROB RUN" Style="{StaticResource Kicker}" Foreground="{StaticResource Accent}"/>
        </StackPanel>
        <TextBlock Text="CONNECTION PATCH   /   v0.3.2" Style="{StaticResource Kicker}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
      </Grid>
    </Border>
  </Grid>
</Grid>
